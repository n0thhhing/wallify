// Debug with assertions, or profile an optimized build without the inspector.
// Configuration reference: https://zed.dev/docs/debugger
[
  {
    "adapter": "CodeLLDB",
    "label": "Wallify: Debug",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/build/bin/wallify",
    "cwd": "$ZED_WORKTREE_ROOT",
    "build": {
      "command": "bash",
      "args": ["scripts/build.sh", "-O", "Debug"],
      "cwd": "$ZED_WORKTREE_ROOT",
      "allow_concurrent_runs": false,
      "save": "all"
    }
  },
  {
    "adapter": "CodeLLDB",
    "label": "Wallify: Profile (ReleaseFast)",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/build/bin/wallify",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": { "WALLIFY_PROFILE": "1" },
    "build": {
      "command": "bash",
      "args": ["scripts/build.sh", "-O", "ReleaseFast"],
      "cwd": "$ZED_WORKTREE_ROOT",
      "allow_concurrent_runs": false,
      "save": "all"
    }
  }
]
