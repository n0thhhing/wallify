#!/usr/bin/env bash
set -euo pipefail

# Navigate to project root
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

# ANSI Colors
BOLD="\033[1m"
GREEN="\033[32m"
BLUE="\033[34m"
YELLOW="\033[33m"
CYAN="\033[36m"
RED="\033[31m"
DIM="\033[2m"
RESET="\033[0m"

APP_NAME="Wallify"
APP_BUNDLE="zig-out/${APP_NAME}.app"
APP_EXEC="${APP_BUNDLE}/Contents/MacOS/${APP_NAME}"

OPTIMIZE="ReleaseFast"
DO_TEST=false
DO_FOREGROUND=false
DO_CLEAN=false
DO_RELAUNCH=false
DO_INSTALL=false
DO_DMG=false
DO_KILL_ONLY=false
DO_SETTINGS=false
DO_WATCH=false

show_help() {
    printf "%b\n" "${BOLD}${APP_NAME} Development & Launch Utility${RESET}

${BOLD}USAGE:${RESET}
  ./run [OPTIONS]

${BOLD}OPTIONS:${RESET}
  -d, --debug            Build in Debug mode (faster compilation, runtime asserts)
  -r, --release          Build in ReleaseFast mode (default, optimized)
  -f, --foreground, -l   Run in foreground; stream logs/stdout directly to terminal
  -w, --watch             Watch source files and automatically rebuild/relaunch on changes
  -t, --test             Run test suite before building & launching
  -C, --clean            Deep clean build cache & temporary artwork files before build
  -k, --kill             Terminate any currently running ${APP_NAME} instances and exit
  -R, --relaunch         Kickstart the LaunchAgent instead of opening the app directly
  -s, --settings         Open the Settings window on launch
  -i, --install          Package and install to /Applications/${APP_NAME}.app
      --dmg              Build a redistributable DMG disk image
  -h, --help             Show this help guide

${BOLD}EXAMPLES:${RESET}
  ./run                  # Quick rebuild, package, and launch in background
  ./run -f               # Rebuild and run in foreground to watch logs
  ./run -w               # Rebuild, launch, then automatically rebuild on changes
  ./run -R               # Rebuild and kickstart the background LaunchAgent
  ./run -d -f            # Debug build running in foreground
  ./run -t               # Run tests first, then build and launch
  ./run -k               # Stop running Wallify widget"
}

# Preserve the original arguments because option parsing below shifts "$@".
ORIGINAL_ARGS=("$@")

# Parse command line options
while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--debug) OPTIMIZE="Debug"; shift ;;
        -r|--release) OPTIMIZE="ReleaseFast"; shift ;;
        -f|--foreground|-l|--logs) DO_FOREGROUND=true; shift ;;
        -w|--watch) DO_WATCH=true; shift ;;
        -t|--test) DO_TEST=true; shift ;;
        -c|-C|--clean) DO_CLEAN=true; shift ;;
        -k|--kill) DO_KILL_ONLY=true; shift ;;
        -R|--relaunch) DO_RELAUNCH=true; shift ;;
        -s|--settings) DO_SETTINGS=true; shift ;;
        -i|--install) DO_INSTALL=true; shift ;;
        --dmg) DO_DMG=true; shift ;;
        -h|--help) show_help; exit 0 ;;
        *) echo -e "${RED}Unknown option: $1${RESET}"; show_help; exit 1 ;;
    esac
done

# Kill-only shortcut
if [[ "$DO_KILL_ONLY" == true ]]; then
    if pgrep -x "$APP_NAME" >/dev/null 2>&1; then
        echo -e "${YELLOW}Stopping ${APP_NAME}...${RESET}"
        pkill -x "$APP_NAME" 2>/dev/null || true
        echo -e "${GREEN}✓ ${APP_NAME} stopped.${RESET}"
    else
        echo -e "${DIM}No running instances of ${APP_NAME} found.${RESET}"
    fi
    exit 0
fi

# 1. Environment & Prerequisites Validation
if ! command -v zig >/dev/null 2>&1; then
    echo -e "${RED}Error: 'zig' compiler not found in PATH.${RESET}" >&2
    echo "Install via Homebrew: brew install zig" >&2
    exit 1
fi

if [[ -z "${DEVELOPER_DIR:-}" ]]; then
    if ! xcrun --show-sdk-path >/dev/null 2>&1 && [[ -d "/Library/Developer/CommandLineTools" ]]; then
        export DEVELOPER_DIR="/Library/Developer/CommandLineTools"
    fi
fi

# 2. Optional: Clean build artifacts
if [[ "$DO_CLEAN" == true ]]; then
    ./scripts/clean.sh
fi

# 3. Optional: Run tests
if [[ "$DO_TEST" == true ]]; then
    echo -e "${BOLD}${BLUE}==>${RESET} ${BOLD}Running test suite...${RESET}"
    if ! zig build test --summary all; then
        echo -e "${RED}✗ Tests failed. Aborting launch.${RESET}" >&2
        exit 1
    fi
    echo -e "  ${GREEN}✓${RESET} All tests passed."
fi

source_snapshot() {
    find . \
        -type d \( -name .git -o -name .zig-cache -o -name zig-out \) -prune -o \
        -type f -exec stat -f '%m:%z:%N' {} + 2>/dev/null |
        shasum -a 256 |
        awk '{print $1}'
}

if [[ "$DO_WATCH" == true ]]; then
    # Watch mode wraps the existing build/launch path instead of duplicating it.
    # Foreground/log mode is intentionally disabled for the child rebuilds so
    # this shell remains available to watch and restart the app.
    WATCH_INITIAL_ARGS=()
    WATCH_REBUILD_ARGS=()
    for arg in "${ORIGINAL_ARGS[@]}"; do
        case "$arg" in
            -w|--watch|-f|--foreground|-l|--logs)
                ;;
            -t|--test|-c|-C|--clean)
                WATCH_INITIAL_ARGS+=("$arg")
                ;;
            *)
                WATCH_INITIAL_ARGS+=("$arg")
                WATCH_REBUILD_ARGS+=("$arg")
                ;;
        esac
    done

    echo -e "${BOLD}${CYAN}==>${RESET} ${BOLD}Watch mode enabled${RESET}"
    echo -e "  ${DIM}Rebuilds when files outside .git/.zig-cache/zig-out change.${RESET}"

    if [[ ${#WATCH_INITIAL_ARGS[@]} -gt 0 ]]; then
        if ! "$0" "${WATCH_INITIAL_ARGS[@]}"; then
            echo -e "${YELLOW}Initial build failed. Watching for the next change...${RESET}"
        fi
    else
        if ! "$0"; then
            echo -e "${YELLOW}Initial build failed. Watching for the next change...${RESET}"
        fi
    fi

    last_snapshot="$(source_snapshot)"
    echo -e "${CYAN}==>${RESET} ${BOLD}Watching...${RESET} ${DIM}(Ctrl+C to quit)${RESET}"

    cleanup_watch() {
        echo ""
        echo -e "${YELLOW}Stopping watch mode...${RESET}"
        exit 0
    }
    trap cleanup_watch INT TERM

    while true; do
        sleep 0.5
        current_snapshot="$(source_snapshot)"

        if [[ "$current_snapshot" == "$last_snapshot" ]]; then
            continue
        fi

        last_snapshot="$current_snapshot"
        echo ""
        echo -e "${CYAN}==>${RESET} ${BOLD}Change detected. Rebuilding ${APP_NAME}...${RESET}"

        if [[ ${#WATCH_REBUILD_ARGS[@]} -gt 0 ]]; then
            if "$0" "${WATCH_REBUILD_ARGS[@]}"; then
                echo -e "${GREEN}✓${RESET} ${APP_NAME} restarted."
            else
                echo -e "${YELLOW}Build failed; existing instance was preserved. Watching for the next change...${RESET}"
            fi
        elif "$0"; then
            echo -e "${GREEN}✓${RESET} ${APP_NAME} restarted."
        else
            echo -e "${YELLOW}Build failed; existing instance was preserved. Watching for the next change...${RESET}"
        fi

        last_snapshot="$(source_snapshot)"
    done
fi

# 4. Compile & Package Application
echo -e "${BOLD}${BLUE}==>${RESET} ${BOLD}Building ${APP_NAME} (${OPTIMIZE})...${RESET}"

# Build with requested optimization level before stopping the existing process
if ! zig build -Doptimize="${OPTIMIZE}"; then
    echo -e "${RED}✗ Compilation failed. Preserving existing running instance.${RESET}" >&2
    exit 1
fi

# Package app bundle (without auto-running yet)
PACKAGE_FLAGS=(-O "$OPTIMIZE")
if [[ "$DO_INSTALL" == true ]]; then
    PACKAGE_FLAGS+=(-i)
fi
if [[ "$DO_DMG" == true ]]; then
    PACKAGE_FLAGS+=(-d)
fi

./scripts/package-app.sh "${PACKAGE_FLAGS[@]}"

# 5. Stop running instance safely before starting new one
if pgrep -x "$APP_NAME" >/dev/null 2>&1; then
    pkill -x "$APP_NAME" 2>/dev/null || true
    sleep 0.2
fi

# 6. Launch Application
TARGET_APP="$APP_BUNDLE"
if [[ "$DO_INSTALL" == true ]]; then
    TARGET_APP="/Applications/${APP_NAME}.app"
fi

APP_ARGS=()
if [[ "$DO_SETTINGS" == true ]]; then
    APP_ARGS+=(--settings)
fi

if [[ "$DO_FOREGROUND" == true ]]; then
    EXEC_PATH="${TARGET_APP}/Contents/MacOS/${APP_NAME}"
    echo -e "${BOLD}${GREEN}==>${RESET} ${BOLD}Running ${APP_NAME} in foreground...${RESET} ${DIM}(Ctrl+C to quit)${RESET}"
    
    trap 'echo ""; echo -e "${YELLOW}Stopping ${APP_NAME}...${RESET}"; exit 0' INT TERM
    if [[ ${#APP_ARGS[@]} -gt 0 ]]; then
        exec "$EXEC_PATH" "${APP_ARGS[@]}"
    else
        exec "$EXEC_PATH"
    fi
elif [[ "$DO_RELAUNCH" == true ]]; then
    ./scripts/relaunch.sh
else
    EXEC_PATH="${TARGET_APP}/Contents/MacOS/${APP_NAME}"
    LAUNCH_LABEL="com.wallify.dev"
    LAUNCH_PLIST="/tmp/${LAUNCH_LABEL}.plist"
    LAUNCH_LOG="/tmp/${LAUNCH_LABEL}.log"
    GUI_DOMAIN="gui/$(id -u)"

    echo -e "${BOLD}${GREEN}==>${RESET} ${BOLD}Launching ${APP_NAME} via launchd (direct executable)...${RESET}"

    # Use launchd's GUI login domain rather than LaunchServices. The job is
    # one-shot: RunAtLoad starts the executable once and KeepAlive=false means
    # a crash/exit is not automatically relaunched.
    launchctl bootout "$GUI_DOMAIN/$LAUNCH_LABEL" 2>/dev/null || true
    rm -f "$LAUNCH_PLIST" "$LAUNCH_LOG"

    {
        echo '<?xml version="1.0" encoding="UTF-8"?>'
        echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
        echo '<plist version="1.0"><dict>'
        echo '    <key>Label</key>'
        printf '    <string>%s</string>\n' "$LAUNCH_LABEL"
        echo '    <key>ProgramArguments</key>'
        echo '    <array>'
        printf '        <string>%s</string>\n' "$EXEC_PATH"
        if [[ ${#APP_ARGS[@]} -gt 0 ]]; then
            for arg in "${APP_ARGS[@]}"; do
                printf '        <string>%s</string>\n' "$arg"
            done
        fi
        echo '    </array>'
        echo '    <key>WorkingDirectory</key>'
        printf '    <string>%s</string>\n' "$PWD"
        echo '    <key>RunAtLoad</key><true/>'
        echo '    <key>KeepAlive</key><false/>'
        echo '    <key>ProcessType</key><string>Interactive</string>'
        echo '    <key>StandardOutPath</key>'
        printf '    <string>%s</string>\n' "/dev/null"
        echo '    <key>StandardErrorPath</key>'
        printf '    <string>%s</string>\n' "$LAUNCH_LOG"
        echo '</dict></plist>'
    } > "$LAUNCH_PLIST"

    if ! launchctl bootstrap "$GUI_DOMAIN" "$LAUNCH_PLIST" 2>"$LAUNCH_LOG"; then
        echo -e "  ${RED}✗ Failed to bootstrap ${APP_NAME} into the GUI launchd domain.${RESET}" >&2
        [[ -s "$LAUNCH_LOG" ]] && cat "$LAUNCH_LOG" >&2
        exit 1
    fi

    sleep 0.5

    NEW_PID=$(pgrep -x "$APP_NAME" 2>/dev/null | head -n 1 || true)
    if [[ -n "$NEW_PID" ]]; then
        echo -e "  ${GREEN}✓${RESET} ${APP_NAME} is running ${DIM}(PID: ${NEW_PID})${RESET}"
    else
        echo -e "  ${YELLOW}Notice:${RESET} ${APP_NAME} exited during startup.${RESET}"
        if [[ -s "$LAUNCH_LOG" ]]; then
            cat "$LAUNCH_LOG" >&2
        fi
        launchctl bootout "$GUI_DOMAIN/$LAUNCH_LABEL" 2>/dev/null || true
        exit 1
    fi
fi
